module Main where

-- A simple token that can be transferred, split from, merged into and add obserevers when needed. 

type AssetId = ContractId Asset

template Asset
  with
    issuer : Party
    owner  : Party
    currency   : Text
    amount : Decimal
    auditors : [Party]
  where
    ensure currency /= "" && amount > 0.0
    signatory issuer
    observer owner, auditors

    choice Transfer : AssetId
      with
        newOwner : Party
      controller owner
      do create this with
           owner = newOwner

    choice Split : (AssetId, AssetId) 
      with amountToSplit : Decimal
     controller owner
        do 
          let amountToKeep = amount - amountToSplit
          splitCid <- create this with amount = amountToSplit
          toKeepCid <- create this with amount = amountToKeep
          return (splitCid, toKeepCid)

    choice Merge : AssetId
      with assetToMergeCid : AssetId
     controller owner
        do
          assetToMerge<- fetch assetToMergeCid
          assert (assetToMerge.issuer == issuer && assetToMerge.owner == owner && assetToMerge.currency == currency)
          archive assetToMergeCid
          create this with amount = amount + assetToMerge.amount

    choice Add_Obserever : ContractId Asset 
      with newObserver : Party
      controller owner
      do create this with auditors = newObserver :: auditors
    
    choice Remove_Obserever : ContractId Asset 
      with
       oldObserver : Party
     controller owner
        do create this with auditors = Prelude.filter (/= oldObserver) auditors