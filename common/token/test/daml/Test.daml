module Test where

import Token

import Daml.Script

setup : Script TokenId
setup = script do
-- user_setup_begin
  alice <- allocatePartyByHint (PartyIdHint "Alice")
  bob <- allocatePartyByHint (PartyIdHint "Bob")
  aliceId <- validateUserId "alice"
  bobId <- validateUserId "bob"
  createUser (User aliceId (Some alice)) [CanActAs alice]
  createUser (User bobId (Some bob)) [CanActAs bob]
  auditor <- allocatePartyByHint (PartyIdHint "Auditor")
  issuer <- allocatePartyByHint (PartyIdHint "Issuer")
  let amountToIssue = 1000.0 : Decimal
-- user_setup_end

  aliceTV <- submit issuer do
    createCmd Token with
      issuer = issuer
      owner = alice
      currency = "CapCan"
      amount = amountToIssue
      auditors = [auditor]

  bobTV <- submit alice do
    exerciseCmd aliceTV Transfer with newOwner = bob

  submit bob do
    exerciseCmd bobTV Transfer with newOwner = alice